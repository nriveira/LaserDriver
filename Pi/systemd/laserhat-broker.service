# LaserHAT broker — the single owner of /dev/ttyS0.
#
# Speaks the binary protocol to the MCU and serves the OLED GUI and web
# GUI over a Unix-domain socket at /run/laserhat/broker.sock.  Both GUIs
# are clients of this daemon, so they no longer conflict over the UART —
# run them together.
#
# Installed by the laserhat package to /usr/lib/laserhat; the 'laserhat'
# system user is created in the package postinst.  Python dependencies
# (python3-serial, python3-gpiozero, python3-lgpio) come from apt — no
# venv, no pip.

[Unit]
Description=LaserHAT broker (owns /dev/ttyS0, serves GUIs over a Unix socket)
After=dev-ttyS0.device
Wants=dev-ttyS0.device

[Service]
Type=simple
User=laserhat
Group=laserhat
# Serial port access; gpiozero needs the gpio group for the PA19 trigger pin.
SupplementaryGroups=dialout gpio
WorkingDirectory=/usr/lib/laserhat
# systemd creates /run/laserhat (0755, owned by User) and exports it.
RuntimeDirectory=laserhat
RuntimeDirectoryMode=0755
Environment=LASERHAT_SOCK=/run/laserhat/broker.sock
ExecStart=/usr/bin/python3 broker.py
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
